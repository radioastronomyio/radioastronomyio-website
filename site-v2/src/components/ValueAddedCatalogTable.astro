---
interface Vac {
  category: string;
  name: string;
  purpose: string;
  url: string;
}

interface Props {
  catalogs: Vac[];
}

const { catalogs } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b-2 border-brand-navy dark:border-dark-text">
        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider text-brand-gray dark:text-gray-400">Category</th>
        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider text-brand-gray dark:text-gray-400">VAC</th>
        <th class="py-3 px-4 font-semibold text-sm uppercase tracking-wider text-brand-gray dark:text-gray-400">Purpose</th>
      </tr>
    </thead>
    <tbody>
      {catalogs.map((vac) => (
        <tr class="border-b border-brand-grid dark:border-dark-surface hover:bg-brand-grid/20 dark:hover:bg-dark-surface/50 transition-colors">
          <td class="py-3 px-4 text-sm">
            <span class:list={[
              'inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full',
              vac.category === 'Galaxy'
                ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                : 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
            ]}>
              {vac.category}
            </span>
          </td>
          <td class="py-3 px-4">
            <a href={vac.url} target="_blank" rel="noopener" class="text-brand-steel hover:underline font-medium inline-flex items-center gap-1">
              {vac.name}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </td>
          <td class="py-3 px-4 text-sm text-brand-gray dark:text-gray-400">{vac.purpose}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
