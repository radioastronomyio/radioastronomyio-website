---
interface Props {
  variant?: 'Active' | 'Planned' | 'Production' | 'Concept';
}

const { variant = 'Active' } = Astro.props;

const colors: Record<string, string> = {
  Active: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
  Planned: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
  Production: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
  Concept: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
};
---

<span class={`inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full ${colors[variant]}`}>
  {variant}
</span>
