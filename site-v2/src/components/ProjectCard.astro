---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  status?: string;
}
const { title, description, image, href, status } = Astro.props;
---

<a
  href={href}
  class="group block rounded-xl overflow-hidden bg-white dark:bg-dark-surface border border-brand-grid dark:border-brand-navy hover:shadow-lg transition-shadow"
>
  <div class="aspect-video overflow-hidden bg-brand-grid dark:bg-dark-surface">
    <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
  </div>
  <div class="p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-lg font-semibold group-hover:text-brand-steel transition-colors">{title}</h3>
      {status && (
        <span class="shrink-0 text-xs font-medium px-2.5 py-0.5 rounded-full bg-brand-steel/10 text-brand-steel dark:bg-brand-steel/20">
          {status}
        </span>
      )}
    </div>
    <p class="mt-2 text-sm text-brand-gray dark:text-gray-400 line-clamp-3">{description}</p>
  </div>
</a>
