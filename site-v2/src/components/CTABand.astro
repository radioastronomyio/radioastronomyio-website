---
interface Props {
  heading: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}
const { heading, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-16 bg-brand-steel dark:bg-brand-navy">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold text-white mb-8">{heading}</h2>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={primaryCta.href}
        class="inline-flex items-center px-6 py-3 bg-white text-brand-navy font-semibold rounded-lg hover:bg-gray-100 transition-colors"
      >
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-flex items-center px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
