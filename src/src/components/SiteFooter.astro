---
const year = new Date().getFullYear();
---

<footer class="bg-brand-navy dark:bg-dark-surface text-white mt-auto">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <h3 class="font-semibold text-lg mb-3">RadioAstronomy.io</h3>
        <p class="text-sm text-gray-300">Open-science computational astronomy built to be reproduced.</p>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Research</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href="/research" class="hover:text-white transition-colors">Overview</a></li>
          <li><a href="/projects/desi-cosmic-void-galaxies" class="hover:text-white transition-colors">Cosmic Voids</a></li>
          <li><a href="/projects/desi-quasar-outflows" class="hover:text-white transition-colors">Quasar Outflows</a></li>
          <li><a href="/projects/desi-qso-anomaly-detection" class="hover:text-white transition-colors">QSO Anomaly Detection</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Organization</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/infrastructure" class="hover:text-white transition-colors">Infrastructure</a></li>
          <li><a href="/sponsors" class="hover:text-white transition-colors">Sponsors</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Connect</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li>
            <a href="https://github.com/radioastronomyio" target="_blank" rel="noopener" class="hover:text-white transition-colors inline-flex items-center gap-1">
              GitHub
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/sponsors/radioastronomyio" target="_blank" rel="noopener" class="hover:text-white transition-colors inline-flex items-center gap-1">
              GitHub Sponsors
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li><a href="mailto:astronomylab@radioastronomy.io" class="hover:text-white transition-colors">astronomylab@radioastronomy.io</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-gray-600 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-400">
      <p>&copy; {year} RadioAstronomy.io. MIT License.</p>
      <a
        href="https://github.com/sponsors/radioastronomyio"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 text-brand-coral hover:text-white transition-colors"
      >
        Support our work
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      </a>
    </div>
  </div>
</footer>
