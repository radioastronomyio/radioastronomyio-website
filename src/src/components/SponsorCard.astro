---
interface Props {
  name: string;
  logo: string;
  url: string;
  provides: string;
}

const { name, logo, url, provides } = Astro.props;

// AI NOTE: Sponsor logos are mixed SVG/PNG assets with different source colors.
// Keep the neutral logo well and dark-mode filter together so new sponsors do
// not need one-off component branches or invisible light/dark-mode logos.
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group block p-6 rounded-xl border bg-white dark:bg-dark-surface border-brand-grid dark:border-brand-navy transition-shadow hover:shadow-lg"
>
  <div class="h-14 flex items-center mb-4 bg-gray-100 dark:bg-white/15 rounded-lg px-4">
    <img
      src={logo}
      alt={`${name} logo`}
      class="max-h-8 max-w-[160px] object-contain dark:brightness-0 dark:invert"
    />
  </div>
  <h3 class="font-semibold mb-1 group-hover:text-brand-steel transition-colors">{name}</h3>
  <p class="text-sm text-brand-gray dark:text-gray-400">{provides}</p>
</a>
