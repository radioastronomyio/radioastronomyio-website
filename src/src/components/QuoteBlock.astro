---
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---

<blockquote class="border-l-4 border-brand-steel pl-6 py-2 my-8">
  <p class="text-lg md:text-xl italic text-brand-navy dark:text-dark-text leading-relaxed">{quote}</p>
  {attribution && <footer class="mt-3 text-sm text-brand-gray dark:text-gray-400">— {attribution}</footer>}
</blockquote>
