---
interface Props {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  external?: boolean;
}

const { label, href, variant = 'primary', external = false } = Astro.props;

const base = 'inline-flex items-center font-semibold rounded-lg transition-colors px-6 py-3';

const variants: Record<string, string> = {
  primary: `${base} bg-brand-steel text-white hover:bg-brand-steel/90`,
  secondary: `${base} border-2 border-brand-navy dark:border-dark-text hover:bg-brand-navy hover:text-white dark:hover:bg-dark-text dark:hover:text-dark-bg`,
  ghost: `${base} text-brand-steel hover:bg-brand-steel/10`,
};
---

<a
  href={href}
  class={variants[variant]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  {label}
  {external && (
    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
  )}
</a>
